# Sturna configuration
# Copy to .env and fill in to arm live execution.

# API server port (default 8787)
PORT=8787

# Robinhood Agentic Trading MCP token.
# Obtain by connecting an agent to https://agent.robinhood.com/mcp/trading
# with an activated Robinhood Agentic Account. When set AND the engine mode is
# switched to "mcp-live", the Executor will route real orders (implement the
# MCP client call in src/core/mcp/robinhoodAdapter.ts first).
RH_MCP_TOKEN=
